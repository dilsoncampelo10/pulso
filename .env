# Configuração pública do PULSO (nada aqui é segredo — tudo vai para o navegador).
# No Cloudflare Pages, sobrescreva em Settings → Environment variables.

# URL pública do jogo, sem barra no final. Usada na URL canônica, sitemap,
# robots.txt, prévias de compartilhamento (Open Graph) e no botão Compartilhar.
VITE_SITE_URL=https://pulso.pages.dev

# E-mail de contato exibido na página de privacidade (opcional).
VITE_CONTACT_EMAIL=

# --- Google AdSense --------------------------------------------------------
# Enquanto VITE_ADSENSE_CLIENT estiver vazio, nenhum script de anúncio é
# carregado e nenhum espaço de anúncio aparece.
# Formato: ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=
# IDs dos blocos de anúncio (AdSense → Anúncios → Por bloco de anúncios → Display).
# Um bloco sem ID fica desligado.
VITE_ADSENSE_SLOT_MENU=
VITE_ADSENSE_SLOT_RESULTS=
VITE_ADSENSE_SLOT_SIDE=

# Mostra caixas tracejadas no lugar dos anúncios para testar o layout (dev).
VITE_ADS_PREVIEW=
